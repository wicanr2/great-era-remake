MAN115
MAN215
MAN315

# 倚天字型（不得散布）
STDFONT.*
SPCFONT.*
ASCFONT.*

# 音訊衍生物：從原版 .MUS/.TIM 轉出來的旋律，與原版資產同等看待
# （docs/formats/06 已 confirmed 那是 AdLib MUS + Timbre Bank，
#  轉成 MIDI 只是換一種表示法，旋律還是原版的）
*.mid
*.midi
*.ogg
*.wav
*.snd
*.bnk

